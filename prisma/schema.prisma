generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. ProducerGroup (작목반 관리) - 인증정보는 여기서 관리
model ProducerGroup {
  id   Int    @id @default(autoincrement())
  code String // 작목반번호 (e.g., '1')
  name String // 작목반명

  certType String // 인증 종류 (유기농, 무농약, 일반)
  certNo   String // 인증 번호 (15102443 등)

  cropYear Int // 생산년도 (2024, 2025...)

  farmers Farmer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, cropYear]) // 같은 년도 내에서는 코드가 유일해야 함
}

// 2. Farmer (생산자/농가 관리)
model Farmer {
  id       Int     @id @default(autoincrement())
  name     String // 농가명
  farmerNo String? // 농가번호 (e.g., '1')
  items    String? // 취급품목
  phone    String? // 연락처 (선택)

  // 잡곡 입고 다이얼로그의 생산자 드롭다운에 노출 여부 (벼 다이얼로그는 무시)
  producesMiscGrain Boolean @default(false)

  groupId Int?
  group   ProducerGroup? @relation(fields: [groupId], references: [id])

  stocks Stock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, farmerNo]) // 그룹 내 농가번호는 유니크해야 함
}

// 3. Variety (품종 관리)
model Variety {
  id             Int                    @id @default(autoincrement())
  name           String                 @unique // 품종명
  type           String // 곡종 구분 (URUCHI, GLUTINOUS, BLACK 등)
  category       StockCategory          @default(RICE) // 벼/잡곡 구분
  aliases        String[]               @default([]) // 발주서 품목명↔품종 별칭 (결정 #22)
  stocks         Stock[]
  outputPackages MillingOutputPackage[] // 잡곡 매입(PURCHASED) 시 직접 참조
  productTypes   ProductType[] // 제품유형(SKU) 카탈로그
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

// 4. Stock (원물 재고: 벼 + 잡곡 위탁도정/농가도정)
model Stock {
  id    Int @id @default(autoincrement())
  bagNo Int // 톤백 번호

  // 카테고리 / 잡곡 입고 유형
  category      StockCategory @default(RICE) // RICE | MISC_GRAIN
  sourceType    SourceType? // 잡곡일 때만: CONSIGNMENT(위탁도정) | FARMER_MILLED(농가도정)
  rawWeightKg   Float? // 위탁도정 잡곡의 원물중량 (수율 계산용)
  millingVendor String? // 위탁 도정업체명

  farmerId     Int
  farmer       Farmer  @relation(fields: [farmerId], references: [id])
  actualFarmer String? // 실제 농사짓는 농가명 (참고용 자유 텍스트)

  varietyId Int
  variety   Variety @relation(fields: [varietyId], references: [id])

  incomingDate   DateTime @default(now()) // 입고일 (로트 생성 기준)
  productionYear Int      @default(2024) // 생산년도
  weightKg       Float // 입고 중량
  status         String // AVAILABLE / CONSUMED / RELEASED
  lotNo          String? // Pre-assigned Lot Number (Default: White Rice basis)

  batchId Int?
  batch   MillingBatch? @relation(fields: [batchId], references: [id])

  releaseId Int?
  release   StockRelease? @relation(fields: [releaseId], references: [id])

  outputPackages MillingOutputPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 4.5 StockRelease (재고 직접 출고/판매 기록)
model StockRelease {
  id          Int      @id @default(autoincrement())
  date        DateTime // 출고일 (사용자 입력)
  destination String // 출고처
  purpose     String? // 출고목적/비고

  stocks Stock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 5. MillingBatch (도정 작업 메인)
model MillingBatch {
  id   Int      @id @default(autoincrement())
  date DateTime @default(now())

  millingType  String  @default("백미")
  remarks      String?
  totalInputKg Float

  stocks  Stock[] // 투입된 벼 리스트
  outputs MillingOutputPackage[] // 생산된 포장 리스트

  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 6. MillingOutputPackage (포장 상세 - 도정산/매입 통합)
//    - source=MILLED: batch + stock 기반 (벼·잡곡 도정산 공통)
//    - source=PURCHASED: 잡곡 외부매입 — batch/stock 미경유, varietyId로 직접 참조
//    CHECK 제약 2개는 마이그레이션 raw SQL에서 추가 (pkg_milled_has_source, pkg_purchased_required_fields)
model MillingOutputPackage {
  id Int @id @default(autoincrement())

  // 출처 구분
  source   ProductSource @default(MILLED) // MILLED | PURCHASED
  category StockCategory @default(RICE) // RICE | MISC_GRAIN

  // MILLED 전용 (PURCHASED일 때 null)
  batchId Int?
  batch   MillingBatch? @relation(fields: [batchId], references: [id])
  stockId Int?
  stock   Stock?        @relation(fields: [stockId], references: [id])

  // PURCHASED 전용 (MILLED일 때 null)
  varietyId      Int?
  variety        Variety?  @relation(fields: [varietyId], references: [id])
  purchaseVendor String? // 매입처명
  incomingDate   DateTime? // 매입일

  // 포장 정보 (공통)
  packageType   String // '20kg', '10kg', '5kg', '2kg', '1kg', '800g', '500g', '420g', 'Tonbag'
  weightPerUnit Float
  count         Int
  totalWeight   Float

  productCode String? // 제품코드 (예: 11)
  lotNo       String? // PURCHASED는 항상 null

  // 제품유형(SKU) 연동 — nullable=백필용. 신규(도정산/매입)는 항상 채움
  productTypeId Int?
  productType   ProductType? @relation(fields: [productTypeId], references: [id])

  // 제품재고 차감 이력 (판매·증정·분실·파손·재포장·기타 — 결정 #19. 가용재고 = count - SUM(movements.count))
  movements PackageMovement[]

  // 재포장으로 생겨난 행이면 그 Repack (결정 #43). 원래부터 있던 행은 null
  repackId Int?
  repack   Repack? @relation(fields: [repackId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repackId])
}

// ------------------------------------------------------
// 6.4 ProductType (제품유형 SKU 카탈로그) + Packaging (포장지명 마스터)
// ------------------------------------------------------

// 포장지명 마스터 (정규화·재사용)
model Packaging {
  id           Int           @id @default(autoincrement())
  name         String        @unique // 자연주의 | 아이담쌀 | PET | 매입포장(sentinel) … (약 20종)
  active       Boolean       @default(true) // 매입포장=false → 도정산 드롭다운 숨김
  productTypes ProductType[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// 제품유형 (SKU 카탈로그) — (품종+도정+규격+포장지) 4키 정규화 ★핵심
model ProductType {
  id          Int                    @id @default(autoincrement())
  varietyId   Int
  variety     Variety                @relation(fields: [varietyId], references: [id])
  millingType String                 @default("기타") // 벼=백미 등, 잡곡='기타' sentinel. NOT NULL
  packageType String // 규격 '10kg' 등
  packagingId Int // NOT NULL ('매입포장' sentinel 허용)
  packaging   Packaging              @relation(fields: [packagingId], references: [id])
  isDefault   Boolean                @default(false) // (품종+도정+규격)당 기본 포장지 추천
  unitsPerBox Int? // 박스 입수(개/박스) (#35). 미입력이면 박스 환산 칸 빈칸 + 경고
  active      Boolean                @default(true)
  packages    MillingOutputPackage[]
  orderItems  PurchaseOrderItem[] // 발주서 라인이 이 SKU로 매칭됨 (결정 #1·#23)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([varietyId, millingType, packageType, packagingId])
  @@index([varietyId, millingType, packageType]) // 기본추천 조회
}

// ------------------------------------------------------
// 6.5 enum 정의
// ------------------------------------------------------
enum StockCategory {
  RICE
  MISC_GRAIN
}

enum SourceType {
  CONSIGNMENT // 도정위탁 — 원물을 외부 도정업체에 위탁해 입고
  FARMER_MILLED // 농가도정 — 농가가 직접 도정해 완제품 납품
  GERMINATION // 발아위탁 — 도정한 현미를 발아전문업체에 위탁해 발아현미로 입고
}

enum ProductSource {
  MILLED
  PURCHASED
}

// 발주서 채널 — 시트명 prefix로 판별 (결정 #11·#26, §2.2)
enum PurchaseChannel {
  DELIVERY // 택배 (택배_YYMMDD) — vendor=주문자, recipient 빈칸→vendor 복사
  EMART // 이마트 (이마트_YYMMDD) — vendor='이마트' 고정, recipient=물류센터(여주/대구/시화)
  MEAL_SEOUL // 서울급식 (서울급식_YYMMDD) — vendor=구청, recipient=행복플러스
  MEAL_HAENAM // 해남급식 (해남급식_YYMMDD) — vendor='해남급식' 고정, recipient=배송업체
  CORPORATE // 기업별 (거래처명_YYMMDD fallback) — vendor=거래처, recipient 빈칸→vendor 복사
}

// 발주서 건 진행상태 — 라인 집계 파생값 (결정 #12)
enum OrderStatus {
  PENDING // 미처리 (차감 0)
  PARTIAL // 부분 차감
  COMPLETED // 전체 차감 완료
}

// 제품재고 차감 유형 — 단일 enum (판매=SALE, 나머지=비판매 차감, 결정 #19)
enum MovementType {
  SALE // 판매 (발주서 일괄 / 개별판매)
  GIFT // 증정
  LOST // 분실
  DAMAGED // 파손
  REPACK // 재포장으로 소진 (결정 #43 — 판매 아님. Repack.sources)
  OTHER // 기타
}

// ------------------------------------------------------
// 7. Authentication (카카오 로그인 전용)
// ------------------------------------------------------

// 사용자 기본 정보 (카카오에서 제공받는 정보 + 우리 앱 전용 정보)
model User {
  id            String    @id @default(cuid())
  name          String? // 카카오 닉네임
  email         String?   @unique // 카카오 이메일
  emailVerified DateTime?
  image         String? // 카카오 프로필 이미지 URL

  // 커스텀 칼럼 추가 ✨
  department String? // 부서
  position   String? // 직책
  phone      String? // 연락처

  role        String   @default("USER") // ADMIN, USER
  permissions String[] @default([]) // 개별 권한 배열: STOCK_MANAGE, MILLING_MANAGE, NOTICE_MANAGE 등
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notices  Notice[]
  accounts Account[]
  sessions Session[]
}

// ------------------------------------------------------
// 8. Notice (대시보드 공지사항 전광판/모달 용)
// ------------------------------------------------------
model Notice {
  id       Int     @id @default(autoincrement())
  title    String // 공지 제목 (마키 배너에서 노출)
  content  String // 전체 공지 내용 (모달 팝업용)
  isActive Boolean @default(true) // 활성화 상태 (true일 때만 표시)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 카카오 계정 연결 정보
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String // "kakao"
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// 로그인 세션 관리용
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 9. SystemConfig (시스템 설정값 - key/value 저장)
// ------------------------------------------------------
model SystemConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// 10. AuditLog (활동 로그/변경 이력 용)
// ------------------------------------------------------
model AuditLog {
  id        Int     @id @default(autoincrement())
  userId    String? // 작업자 ID (User.id)
  userName  String? // 작업자 이름 (탈퇴 대비용 기록)
  userEmail String? // 작업자 이메일

  action   String // 작업 종류: CREATE, UPDATE, DELETE, LOGIN 등
  entity   String // 작업 대상: Stock, MillingBatch, Farmer, User 등
  entityId String? // 대상의 ID (레코드 식별자)

  details     Json? // 구체적인 변경 내용 (이전값, 새값 등)
  description String? // 사람이 읽기 좋은 요약 설명

  ip        String? // 접속 IP (선택 사항)
  userAgent String? // 접속 기기 정보 (선택 사항)

  createdAt DateTime @default(now())
}

// ------------------------------------------------------
// 11. 발주서 판매처리 도메인 (§8.2 — 발주서 업로드 → 제품재고 차감 → 판매관리)
//     PurchaseOrderUpload(묶음) → PurchaseOrder(건) → PurchaseOrderItem(라인) → PackageMovement(차감)
// ------------------------------------------------------

// 11.0 배송업체 마스터 — 화물사·직접배송·방문수령. 수출건 임시 업체도 관리화면에서 등록해 쓴다 (결정 #36)
model ShippingVendor {
  id        Int                   @id @default(autoincrement())
  name      String                @unique // '경동화물'
  sortOrder Int                   @default(0) // 목록 표시 순서
  active    Boolean               @default(true) // 안 쓰는 업체는 숨김 — 과거 묶음은 유지 (결정 #39)
  uploads   PurchaseOrderUpload[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

// 상차 시각 — 날짜는 알아도 시각은 대개 미정이라 UNKNOWN이 기본값 (결정 #37)
enum LoadingTimeSlot {
  UNKNOWN
  AM
  PM
  EXACT // loadingTime에 'HH:mm'이 들어있을 때만
}

// 11.1 업로드 묶음 — 시트 1장 = 묶음 1건 (#30). 중복감지(#16)·묶음목록·감사·일괄삭제 앵커
model PurchaseOrderUpload {
  id               Int             @id @default(autoincrement())
  fileName         String // 원본 파일명 (중복감지 키의 일부)
  sheetName        String // 시트명 '택배_260818' — 묶음 단위가 시트라서 키의 일부 (#30)
  channel          PurchaseChannel // 묶음 단위 채널 (#30 — 업로드 때 사용자가 확정, #31)
  orderDate        DateTime? // 시트별 발주일 (시트명·제목에서 추측 후 사용자 확정)
  note             String? // 묶음 비고 — 묶음목록 ⋮ 메뉴에서 수정
  orderCount       Int             @default(0) // 적재된 PurchaseOrder 수 (요약·검증)
  // 배송·상차 (결정 #37 — 전부 nullable. 비면 목록에 「배차 미정」으로 남아 오히려 채워진다)
  shippingVendorId Int?
  shippingVendor   ShippingVendor? @relation(fields: [shippingVendorId], references: [id])
  loadingDate      DateTime? // 상차일
  loadingTimeSlot  LoadingTimeSlot @default(UNKNOWN)
  loadingTime      String? // 'HH:mm' — slot이 EXACT일 때만

  uploadedById String? // 업로더 (User.id, relation 미설정 — 단순 저장)
  uploadedName String? // 업로더명 (탈퇴 대비)
  orders       PurchaseOrder[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([fileName, sheetName, orderDate]) // 재업로드 중복 감지 (#16 개정 — 파일+시트+발주일)
  @@index([loadingDate]) // 묶음목록 상차 임박순 정렬
  @@index([channel, createdAt]) // 채널별 최근 3건 — 추천 배송업체 조회 (결정 #38)
}

// 11.2 주문 1건 = 발주처 + 수령인 = 엑셀 한 행 (결정 #11)
model PurchaseOrder {
  id        Int                  @id @default(autoincrement())
  uploadId  Int?
  upload    PurchaseOrderUpload? @relation(fields: [uploadId], references: [id])
  channel   PurchaseChannel // 5종(#26) — 시트명 prefix로 판별
  orderDate DateTime? // 발주일(있으면)
  vendor    String // 발주처
  recipient String // 수령인 (택배·기업별은 빈칸 시 파서가 vendor 복사, #26)
  status    OrderStatus          @default(PENDING) // 라인 집계 파생값 (결정 #12)
  items     PurchaseOrderItem[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([uploadId])
  @@index([vendor, recipient]) // 중복감지 보조 키(#16)
}

// 11.3 품목 라인 = 엑셀 셀 1개 = (품종+도정+규격+포장지) 1조합 + 주문수량
model PurchaseOrderItem {
  id      Int           @id @default(autoincrement())
  orderId Int
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // --- 파싱 원본 스냅샷 (매칭 실패 시 수동지정·재매칭·감사에 필요) ---
  rawItemName  String // 원본 품목명 '유기농\n가바백미' (정규화 전 보존)
  packageType  String // 규격(중량) '10kg' — 파싱에서 직접 추출
  rawPackaging String? // 포장지 원본('자연주의' 등). 빈칸이면 null → 기본 포장지 적용(#21)
  orderedQty   Int // 주문 수량(셀 값)
  unitWeightKg Float? // 톤백류 요구 자루중량 kg (#34). 일반 규격은 null

  // --- 매칭 결과 ---
  productTypeId Int? // 매칭 성공 시 SKU 1:1. 실패=null(=매칭실패, 포장담당 수동, #18)
  productType   ProductType? @relation(fields: [productTypeId], references: [id])

  movements PackageMovement[] // 이 라인을 실제 차감한 로트별 배분(type=SALE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([orderId])
  @@index([productTypeId])
}

// 11.4 제품재고 차감 통합 모델 (결정 #19 — 세 경로 단일 테이블)
//      발주서 일괄 / 개별 판매 / 비판매 차감 모두 "MillingOutputPackage에서 count개 차감"
model PackageMovement {
  id        Int                  @id @default(autoincrement())
  packageId Int
  package   MillingOutputPackage @relation(fields: [packageId], references: [id])
  count     Int // 차감 개수(양수)
  type      MovementType // SALE | GIFT | LOST | DAMAGED | REPACK | OTHER (판매=SALE)

  orderItemId Int? // 발주서 경로만. 개별판매·비판매차감은 null
  orderItem   PurchaseOrderItem? @relation(fields: [orderItemId], references: [id])

  repackId Int? // 재포장 경로만(type=REPACK). 그 외는 null (결정 #43)
  repack   Repack? @relation(fields: [repackId], references: [id])

  customer   String? // 개별판매 거래처(자유 텍스트). 발주서는 order에서 파생되므로 null
  note       String? // 비판매 사유 메모 등
  occurredAt DateTime @default(now()) // 실제 차감/판매 발생일(사용자 입력 가능)

  createdById String? // 작업자 (감사 보강 — 하드삭제 대비, relation 미설정)
  createdName String?
  createdAt   DateTime @default(now())

  // ※ 금액(단가·매출액) 필드 없음 — 수량 차감만 (결정 #25)
  @@index([packageId]) // 가용재고 SUM 조회 핵심 인덱스
  @@index([orderItemId])
  @@index([repackId])
}

// ------------------------------------------------------
// 11.5 재포장 (결정 #43) — 분할·병합·규격변경을 하나로
//      소스 행 N개를 소진(sources: type=REPACK movement)하고 결과 행 M개를 만든다.
//      가용재고 공식(count - SUM(movements.count))은 그대로 두고 그 위에 얹힌다.
//        분할   톤백 1,004kg×1 → 1,000kg×1 + 4kg×1
//        규격변경 잔량 4kg×1    → 1kg×4
//        병합   잔량 10행 84kg → 20kg×4 + 잔량 4kg
// ------------------------------------------------------
model Repack {
  id         Int      @id @default(autoincrement())
  occurredAt DateTime @default(now()) // 실제 작업일(사용자 입력 가능)
  note       String?
  lossKg     Float    @default(0) // 소스 합 - 결과 합 (0 이상. 실물 오차 허용)

  createdById String? // 작업자 (감사 보강 — relation 미설정)
  createdName String?

  sources PackageMovement[] // 소진된 소스 (type=REPACK)
  results MillingOutputPackage[] // 새로 생긴 결과 행

  createdAt DateTime @default(now())

  @@index([occurredAt])
}
